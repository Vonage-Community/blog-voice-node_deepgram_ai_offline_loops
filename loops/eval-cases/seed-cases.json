    "mockToolResult": { "status": "not_found" },
    "notes": "not_found is a valid result, not a fallback"
  },
  {
    "id": "seed-004",
    "input": "I want to dispute a charge",
    "expectedOutcome": "handoff",
    "expectedFallback": false,
