# -----------------------------------------------------------------------------
# Part 2 needs three settings, and only the first one matters. No Vonage
# credentials, no Deepgram API key,
# no phone number — the offline loops never touch the live voice path. They read
# the call records Part 1 already wrote, and write eval cases back to the same
# file.
# -----------------------------------------------------------------------------

# Path to Part 1's SQLite database, relative to this `loops/` directory.
# Part 1's own .env sets DB_PATH=./data/calls.db from the repo root, so from
# here — one level down — the same file is ../data/calls.db.
#
# Point this at the same file Part 1 writes to. If you point it somewhere new,
# the loops will happily create an empty database and find nothing to review.
DB_PATH=../data/calls.db

# Which agent version to stamp on eval reports. Part 1 reads the same variable
# and defaults to the same string, so leaving this alone keeps reports and call
# records talking about the same agent. Bump it in both places when you change
# the prompt, the tool policy, or a model.
AGENT_VERSION=order-status-v1

# How many recent calls `npm run review` looks back over. Default 50.
REVIEW_WINDOW=50
