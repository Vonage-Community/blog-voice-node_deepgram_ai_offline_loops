# Secrets — never commit these. Set up before any .env/key file is created.
.env
.env.*
!.env.example
*.key
*.pem

# Dependencies and build output
node_modules/
dist/

# Generated eval reports from `npm run eval` — regenerated per run, not evidence
loops/reports/

# SQLite database files (call evidence is regenerated per run)
*.db
*.db-journal
*.sqlite
data/

# ...but loops/data/ is committed fixture INPUT, not generated evidence. The
# `data/` rule above matches at any depth, so the seed file needs an explicit
# escape or it silently never gets committed.
!loops/data/

# Logs and OS cruft
*.log
.DS_Store

# Local tooling / internal planning notes — not part of the published tutorial
.claude/
tasks/
