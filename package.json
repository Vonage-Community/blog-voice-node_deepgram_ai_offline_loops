{
  "name": "bounded-order-status-voice-agent",
  "version": "1.0.0",
  "description": "Part 1: a bounded order-status voice agent on Vonage Voice API + Deepgram Voice Agent — one approved tool, strict timeouts, tested fallbacks, and structured call evidence for Part 2.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-ws": "^5.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/express-ws": "^3.0.6",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.5.13",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
