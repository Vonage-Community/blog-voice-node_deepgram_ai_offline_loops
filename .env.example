# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# The Vonage application and its keys are created in the prerequisite guide:
# https://developer.vonage.com/en/voice/voice-api/guides/voice-ai-agent-deepgram
# ---------------------------------------------------------------------------

# --- Vonage Voice API ---
# From the Vonage dashboard (Applications). The private key is downloaded once
# when you create the application; store the file locally and point to it here.
# VONAGE_APP_ID + VONAGE_PRIVATE_KEY_PATH are used to sign the JWT for the real
# human-transfer call (src/voice/transfer-to-human.ts).
VONAGE_APP_ID=
VONAGE_PRIVATE_KEY_PATH=./vonage_private.key
# Your Vonage virtual number (E.164). Used as the `from` on the transfer's
# connect leg, and it's the number callers dial.
VONAGE_NUMBER=

# --- Human transfer ---
# The phone number (E.164) an out-of-scope caller is transferred to. Leave blank
# to disable real transfers (the handoff is still recorded; the call just isn't
# connected to a human). For dev this is simply another phone you can answer.
SUPPORT_PHONE_NUMBER=

# --- Deepgram Voice Agent (ASR + LLM orchestration + Aura TTS) ---
# https://console.deepgram.com/ -> API Keys
DEEPGRAM_API_KEY=

# Optional model overrides. Defaults live in src/agent/agent-config.ts and match
# the tutorial stack (Deepgram nova-3 ASR, Anthropic Claude think, Aura-2 TTS).
# Leave blank to use the defaults.
DEEPGRAM_LISTEN_MODEL=
DEEPGRAM_THINK_MODEL=
DEEPGRAM_SPEAK_MODEL=

# --- Local server / tunnel ---
# Port the Express server listens on.
PORT=3000
# Public HTTPS base URL of your ngrok tunnel (or deployment). Used to build the
# WebSocket URI and event webhook URL. Do NOT derive these from req.hostname —
# behind ngrok it can resolve to "localhost" and break webhook delivery.
# Example: https://your-subdomain.ngrok-free.app
BASE_URL=

# --- Storage ---
# Path to the SQLite database that holds call records (the bridge to Part 2).
# Use ":memory:" for an ephemeral database (tests use this).
DB_PATH=./data/calls.db

# --- Agent version ---
# Stamped onto every call record so Part 2 can compare calls across versions.
# Bump this when you change the prompt, tool policy, or a model. Defaults to
# "order-status-v1" if unset.
AGENT_VERSION=order-status-v1
